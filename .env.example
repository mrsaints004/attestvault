# --- Source chain 1 (where RWA assets get pledged, e.g. Ethereum Sepolia) ---
SOURCE_CHAIN_RPC_URL=
SOURCE_CHAIN_KEY=1

# --- Source chain 2 (OPTIONAL — leave both blank to run single-chain only) ---
SOURCE_CHAIN_2_RPC_URL=
SOURCE_CHAIN_2_KEY=

# --- Creditcoin CC3 Testnet ---
CREDITCOIN_RPC_URL=
PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network/

# --- Keys ---
DEPLOYER_PRIVATE_KEY=
RISK_ENGINE_PRIVATE_KEY=
LENDER_WALLET_PRIVATE_KEY=

# --- Filled in after deploy (npx ts-node scripts/deploy.ts) ---
AUXILIARY_ASSET_VAULT_ADDRESS=
AUXILIARY_ASSET_VAULT_2_ADDRESS=
COLLATERAL_MANAGER_ADDRESS=
RISK_SCORE_ORACLE_ADDRESS=
