.worker-cursors.json

# --- Forge std (installed via forge install, not committed) ---
/lib/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editor / OS cruft ---
.vscode/*
